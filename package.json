{
  "name": "@revfanc/use",
  "version": "1.2.2",
  "description": "A collection of Vue 3 Composition API utilities",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "dev:example": "cd examples && vite"
  },
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "composition-api"
  ],
  "author": "revfanc",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.40",
    "vue-tsc": "^2.2.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revfanc/use.git"
  },
  "bugs": {
    "url": "https://github.com/revfanc/use/issues"
  },
  "homepage": "https://revfanc.github.io/use"
}
